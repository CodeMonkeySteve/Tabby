!!!
%html{ xmlns: 'http://www.w3.org/1999/xhtml', 'xml:lang': 'en', lang: 'en', data: { bs: { theme: 'auto' } } }
  %head
    %title= content_for(:title) || "Tabby"

    %meta{'http-equiv': 'Content-Type', content: 'text/html; charset=UTF-8'}/
    %meta{name: 'viewport', content: 'width=device-width,initial-scale=1'}/
    %meta{name: 'apple-mobile-web-app-capable', content: 'yes'}/
    %meta{name: 'application-name', content: 'Tabby'}/
    %meta{name: 'mobile-web-app-capable', content: 'yes'}/
    %link{rel: 'icon', href: '/favicon.ico', sizes: '32x32'}/
    %link{rel: 'icon', href: '/favicon.svg', type: 'image/svg+xml'}/
    %link{rel: 'apple-touch-icon', href: '/apple-touch-icon.png'}/

    = javascript_include_tag 'color-modes'
    = csrf_meta_tag
    = csp_meta_tag
    = yield :head

    -# for some reason it doesn't work to @import this into SASS
    %link{rel: 'stylesheet', href: 'https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css'}

    = stylesheet_link_tag 'application', 'data-turbo-track': 'reload'
    = javascript_importmap_tags

  %body
    = render partial: 'layouts/header'

    .container
      - if controller.flash.present?
        .navbar.flash-messages
          - if controller.flash[:success].present?
            .alert.alert-success= controller.flash[:success]

          - if controller.flash[:notice].present?
            .alert.alert-info= controller.flash[:notice]

          - if controller.flash[:error].present?
            .alert.alert-error= controller.flash[:error]

      = yield

    #footer
