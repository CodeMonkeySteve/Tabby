- content_for :title, "Tabby - Dashboard"

.dashboard
  .card.mb-4
    .card-header.d-flex.align-items-center
      %i.bi.bi-calendar3.me-2
      Practice
      %span.ms-auto.text-body-secondary.small= "Last #{Dashboard::ACTIVITY_WEEKS} weeks"
    .card-body.d-flex.flex-wrap.align-items-center.gap-4
      = render 'activity_graph', dashboard: @dashboard

      = render layout: 'practice_summary', locals: { title: "This week", summary: @dashboard.week_summary } do
        %dt Weeks in a row
        %dd= @dashboard.weeks_in_a_row

      - last_session = @dashboard.session_summary
      - practiced_today = last_session.date == @dashboard.today
      = render layout: 'practice_summary', locals: { title: practiced_today ? "Today" : "Last session",
                                                     subtitle: (relative_date(last_session.date) unless practiced_today),
                                                     summary: last_session } do
        %dt Top song
        %dd.text-truncate
          - if (song = last_session.top_song)
            = link_to song.title, player_path(song), title: song.artist
          - else
            &mdash;

  .row.g-4
    .col-lg-4
      .card.h-100
        .card-header.d-flex.align-items-center
          %i.bi.bi-music-note-list.me-2
          Playlists
          = link_to new_playlist_path, class: 'ms-auto', title: "New playlist" do
            %i.bi.bi-plus-lg
        - if @dashboard.playlists.any?
          .accordion.accordion-flush#playlists
            - @dashboard.playlists.each do |playlist|
              - songs = @dashboard.playlist_songs(playlist)
              .accordion-item
                %h2.accordion-header
                  %button.accordion-button.collapsed{type: 'button', data: { bs: { toggle: 'collapse', target: "#playlist-#{playlist.id}" } },
                                                     aria: { expanded: false, controls: "playlist-#{playlist.id}" }}
                    = playlist.name
                    %span.badge.text-bg-secondary.rounded-pill.ms-2= songs.size
                .accordion-collapse.collapse{id: "playlist-#{playlist.id}", data: { bs: { parent: '#playlists' } }}
                  .list-group.list-group-flush
                    - songs.each do |song|
                      = link_to playlist_player_path(playlist, song), class: 'list-group-item list-group-item-action' do
                        = song.title
                        %small.text-body-secondary= song.artist
                    = link_to playlist, class: 'list-group-item list-group-item-action small text-body-secondary' do
                      %i.bi.bi-pencil.me-1
                      Edit playlist
        - else
          .card-body.text-body-secondary
            No playlists yet.

    .col-lg-4
      .card.h-100
        .card-header
          %i.bi.bi-clock-history.me-2
          Recently Played
        - if @dashboard.recent_plays.any?
          .list-group.list-group-flush
            - @dashboard.recent_plays.each do |play|
              = link_to player_path(play.song), class: 'list-group-item list-group-item-action d-flex align-items-center gap-2' do
                .text-truncate
                  = play.song.title
                  %small.d-block.text-body-secondary= play.song.artist
                %small.ms-auto.text-end.text-nowrap.text-body-secondary
                  = relative_date(play.date)
                  %span.d-block{title: "Total practice time"}= practice_time(play.seconds)
        - else
          .card-body.text-body-secondary
            Songs you play will appear here.

    .col-lg-4
      .card.h-100
        .card-header.d-flex.align-items-center
          %i.bi.bi-plus-circle.me-2
          Recently Added
          - if current_user.instrument_types.any?
            %span.ms-auto.small.text-body-secondary{title: "Songs with a track for your instruments"}
              = current_user.instrument_types.map(&:humanize).to_sentence
          - else
            = link_to "Choose your instruments", settings_path, class: 'ms-auto small'
        - if @dashboard.recent_songs.any?
          .list-group.list-group-flush
            - @dashboard.recent_songs.each do |song|
              -# the playlist button can't be inside the song's link, so the link fills the rest of the item
              .list-group-item.list-group-item-action.d-flex.gap-2
                = link_to player_path(song), class: 'flex-grow-1 text-truncate text-reset text-decoration-none' do
                  = song.title
                  %small.d-block.text-body-secondary= song.artist
                  .d-flex.flex-wrap.gap-1
                    - song.instrument_types.each do |type|
                      %span.badge{class: current_user.instrument_types.include?(type) ? 'text-bg-primary' : 'text-bg-secondary'}= type
                .d-flex.flex-column.align-items-end.justify-content-between
                  %small.text-nowrap.text-body-secondary= relative_date(song.created_at.to_date)
                  .dropdown
                    %button.btn.btn-sm.p-0{type: 'button', title: "Playlists", aria: { expanded: false, haspopup: true },
                                           data: { bs: { toggle: 'dropdown', 'auto-close': 'outside' } }}
                      %i.bi.bi-folder-plus
                    .dropdown-menu.dropdown-menu-end.p-2{style: 'min-width: 220px'}
                      = render 'songs/playlist_menu', song:, playlists: @dashboard.playlists
        - else
          .card-body.text-body-secondary
            No songs for your instruments yet.
