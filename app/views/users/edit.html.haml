- content_for :title, "Settings"

%h1 Settings

= form_with(url: settings_path, model: @user) do |f|
  - if @user.errors.any?
    .alert.alert-danger
      %h4= "#{pluralize(@user.errors.count, 'error')} prohibited your settings from being saved:"
      %ul
        - @user.errors.full_messages.each do |message|
          %li= message

  .form-inputs
    .mb-3
      = f.label :name, class: 'form-label'
      = f.text_field :name, class: 'form-control'

    .mb-3
      = f.label :email, class: 'form-label'
      = f.email_field :email, required: true, class: 'form-control'

    .mb-3
      #instruments-label.form-label Instruments
      -# submitted when every instrument is unchecked (outside the group, which only rounds its last child's corners)
      = hidden_field_tag 'user[instrument_types][]', '', id: nil
      .btn-group.flex-wrap{role: 'group', aria: { labelledby: 'instruments-label' }}
        = f.collection_check_boxes :instrument_types, User::INSTRUMENT_TYPES.map(&:to_s), :itself, :humanize, include_hidden: false do |b|
          = b.check_box class: 'btn-check', autocomplete: 'off'
          = b.label class: 'btn btn-outline-primary'
      .form-text The player shows the tracks for these instruments by default.

  .form-actions
    = button_tag type: 'submit', class: 'btn btn-primary px-5' do
      %i.bi.bi-save
      Save

    = link_to "Cancel", :back, class: 'btn btn-secondary mx-2'
