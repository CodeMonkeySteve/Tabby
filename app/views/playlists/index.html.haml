- content_for :title, "Playlists"

.d-flex.align-items-center.mb-3
  %h1.me-auto.mb-0 Playlists
  = link_to new_playlist_path, class: 'btn btn-primary' do
    %i.bi.bi-plus-lg
    New Playlist

- if @playlists.any?
  .list-group.playlists
    - @playlists.each do |playlist|
      = link_to playlist, class: 'list-group-item list-group-item-action d-flex justify-content-between align-items-center' do
        %span= playlist.name
        %span.badge.text-bg-secondary.rounded-pill{title: pluralize(playlist.song_ids.size, "song")}= playlist.song_ids.size
- else
  %p.text-body-secondary No playlists yet
