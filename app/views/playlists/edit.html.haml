- content_for :title, "Editing #{@playlist.name}"

%h1= @playlist.name

-# shown with the form's buttons, but submits its own form below, since forms can't be nested
- content_for :buttons do
  %button.btn.btn-danger.btn-sm.ms-5.float-end{type: 'submit', form: 'delete_playlist'}
    %i.bi.bi-x-circle
    Delete

= render 'form', playlist: @playlist
= form_with(model: @playlist, method: :delete, id: 'delete_playlist') { }
