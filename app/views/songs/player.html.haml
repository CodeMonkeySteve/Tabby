!!!
%html{ xmlns: 'http://www.w3.org/1999/xhtml', 'xml:lang': 'en', lang: 'en', data: { bs: { theme: 'auto' } } }
  %head
    %title= "#{@song.title} (#{@song.artist})"

    %meta{'http-equiv': 'Content-Type', content: 'text/html; charset=UTF-8'}/
    %meta{name: 'viewport', content: 'width=device-width,initial-scale=1'}/
    %meta{name: 'apple-mobile-web-app-capable', content: 'yes'}/
    %meta{name: 'application-name', content: 'Tabby'}/
    %meta{name: 'mobile-web-app-capable', content: 'yes'}/
    %link{rel: 'icon', href: '/favicon.ico', sizes: '32x32'}/
    %link{rel: 'icon', href: '/favicon.svg', type: 'image/svg+xml'}/
    %link{rel: 'apple-touch-icon', href: '/apple-touch-icon.png'}/

    = csrf_meta_tags
    -# a standalone page (with AlphaTab's workers and audio), so always load it fully rather than with a Turbo visit
    %meta{name: 'turbo-visit-control', content: 'reload'}/

    %link{href: 'https://fonts.googleapis.com/css?family=Roboto:300,400,400i,500,700&display=swap', rel: 'stylesheet'}/

    = stylesheet_link_tag 'player', integrity: true, data: { 'turbo-track': 'reload' }
    %link{href: 'https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.7.2/css/all.min.css', rel: 'stylesheet'}/
    -# for the shared playlist menu
    %link{href: 'https://cdn.jsdelivr.net/npm/bootstrap-icons@1.9.1/font/bootstrap-icons.css', rel: 'stylesheet'}/

    = stylesheet_link_tag 'application', 'data-turbo-track': 'reload'
    = javascript_include_tag 'color-modes'
    = javascript_importmap_tags

  %body
    = render partial: 'layouts/header'

    - song_attributes = { id: @song.to_param, title: @song.title, artist: @song.artist, syncPoints: @song.sync_points || [],
                          trackTypes: @song.track_types, tracks: @song.track_indexes_for(current_user.instrument_types).presence,
                          note: @song.note&.playback,
                          alternateTabs: @song.alternate_tabs.where(user: current_user).map(&:for_player) }
    - previous_url = playlist_player_path(@playlist, @previous_song) if @previous_song
    .at-wrap.loading{data: { controller: 'player', player: { song_value: song_attributes.to_json, previous_url_value: previous_url,
                                                             sync_editor_outlet: '.sync-editor' } } }
      .at-overlay
        .at-overlay-content
          .spinner-border{role: 'status', style: 'width: 3rem; height: 3rem;'}
      .at-osd{aria: { live: 'polite' }, data: { player: { target: 'osd' } }}
        %i{data: { player: { target: 'osdIcon' } }}
        %span{data: { player: { target: 'osdText' } }}
      .at-content
        .at-viewport
          #alphaTab.at-canvas{data: { player: { target: 'canvas' } }}
        .at-track-panel{data: { player: { target: 'trackPanel' } }}
          %button.at-track-panel-close{type: 'button', title: "Close", data: { action: 'player#toggleTracks' }}
            %i.fas.fa-close
          %h4 Tracks
          .at-track-list{data: { player: { target: 'trackList' } }}
      -# stays at the bottom of the window as the page scrolls
      .at-dock{data: { player: { target: 'dock' } }}
        - if @song.audio.present?
          .sync-editor{data: { controller: 'sync-editor', sync_editor: { song_id_value: @song.to_param } }}
            .sync-toolbar
              %div
                .btn-group
                  %button.btn.btn-sm.btn-outline-secondary{type: 'button', title: "Auto Sync", data: { action: 'sync-editor#performAutoSync' }}
                    %i.fas.fa-magic
                    Auto Sync
                  %button.btn.btn-sm.btn-outline-secondary{type: 'button', title: "Reset Sync Points", data: { action: 'sync-editor#performResetSyncPoints' }}
                    %i.fas.fa-map-pin
                    Reset
                %button.btn.btn-sm.btn-outline-secondary{type: 'button', title: "Zoom Out", data: { action: 'sync-editor#zoomOut' }}
                  %i.fas.fa-magnifying-glass-minus
                %button.btn.btn-sm.btn-outline-secondary{type: 'button', title: "Reset Zoom", data: { action: 'sync-editor#resetZoom', sync_editor: { target: 'zoomLabel' } }}
                  100%
                %button.btn.btn-sm.btn-outline-secondary{type: 'button', title: "Zoom In", data: { action: 'sync-editor#zoomIn' }}
                  %i.fas.fa-magnifying-glass-plus
                %button.btn.btn-sm.btn-outline-secondary{type: 'button', title: "Undo", data: { action: 'sync-editor#performUndo', sync_editor: { target: 'undoBtn' } }, disabled: true}
                  %i.fas.fa-undo
                %button.btn.btn-sm.btn-outline-secondary{type: 'button', title: "Redo", data: { action: 'sync-editor#performRedo', sync_editor: { target: 'redoBtn' } }, disabled: true}
                  %i.fas.fa-redo
              %div
                %span.text-muted.me-2{data: { sync_editor: { target: 'statusMsg' } }}
                %button.btn.btn-sm.btn-primary{type: 'button', title: "Save", data: { action: 'sync-editor#save', sync_editor: { target: 'saveBtn' } }}
                  %i.fas.fa-save
                  Save
            .sync-area{data: { action: 'scroll->sync-editor#onScroll', sync_editor: { target: 'syncArea' } }}
              .sync-area-canvas-wrap
                %canvas{data: { sync_editor: { target: 'canvas' } }}
              .sync-area-marker-wrap{data: { action: 'click->sync-editor#onSyncAreaClick', sync_editor: { target: 'markerWrap' } }}
              .sync-area-playback-cursor{data: { sync_editor: { target: 'cursor' } }}
        .at-footer
          .at-time-slider
            .at-time-slider-value{data: { player: { target: 'timeSliderValue' } }}
          .at-player
            .at-player-left
              %a.at-skip-back.disabled{href: '#', title: @previous_song ? "Back to Start, or Previous Song" : "Back to Start",
                                       data: { action: 'player#skipBack' }}
                %i.fas.fa-backward-step
              %a.at-play-pause.disabled{href: '#', title: "Play/Pause (Space)", data: { action: 'player#playPause', player: { target: 'playPause' } }}
                %i.fas.fa-play
              - if @next_song
                = link_to playlist_player_path(@playlist, @next_song), class: 'at-skip-forward', title: "Next Song", data: { turbo: false } do
                  %i.fas.fa-forward-step
              - else
                %a.at-skip-forward.unavailable{title: "Next Song", aria: { disabled: true }}
                  %i.fas.fa-forward-step
              %a.at-tracks{href: '#', title: "Tracks", data: { action: 'player#toggleTracks' }}
                %i.fas.fa-list-check
              .btn-group.dropup
                %button.btn.dropdown-toggle{type: 'button', title: "Speed (Numpad +/-)", aria: { expanded: false, haspopup: true }, data: { bs: { toggle: 'dropdown', 'auto-close': 'outside' } }}
                  %i.fas.fa-gauge
                .dropdown-menu.at-speed-options
                  .at-slider-container
                    %span.at-slider-label Speed
                    %input{type: 'range', min: 50, max: 200, value: 100, step: 5, data: { action: 'input->player#changeSpeed', player: { target: 'speedSlider' } }}/
                    %span.at-slider-value{data: { player: { target: 'speedLabel' } }} 1x
              .btn-group.dropup
                %button.btn.dropdown-toggle{type: 'button', title: "Volume (Up/Down Arrows)", aria: { expanded: false, haspopup: true }, data: { bs: { toggle: 'dropdown', 'auto-close': 'outside' } }}
                  %i.fas.fa-volume-low{data: { player: { target: 'volumeIcon' } }}
                .dropdown-menu.at-volume-options
                  .at-slider-container
                    %span.at-slider-label Volume
                    %input.at-master-volume{type: 'range', min: 0, max: 100, value: 50, data: { action: 'input->player#changeVolume', player: { target: 'volumeSlider' } }}/
                    %span.at-slider-value{data: { player: { target: 'volumeLabel' } }} 50%

              .at-player-loading.progress{data: { player: { target: 'playerLoading' } }}
                %span.progress-left
                  %span.progress-bar
                %span.progress-right
                  %span.progress-bar
                .progress-value.w-100.h-100.rounded-circle.d-flex.align-items-center.justify-content-center.font-weight-bold
                  %span.progress-value-number 0
                  %sup.small %
              .at-time-position{title: "Time Position", data: { player: { target: 'timePosition' } }}

            .at-player-center
              .at-song-details
                %span.at-song-title{data: { player: { target: 'songTitle' } }}
                %span.at-song-artist{data: { player: { target: 'songArtist' } }}

            .at-player-right
              %a.at-count-in.disabled{href: '#', title: "Count-In", data: { action: 'player#toggleCountIn', player: { target: 'countIn' } }}
                %i.fas.fa-hourglass-half
              %a.at-metronome.disabled{href: '#', title: "Metronome", data: { action: 'player#toggleMetronome', player: { target: 'metronome' } }}
                = image_tag 'metronome-icon.svg', class: 'icon'
              %a.at-loop.disabled{href: '#', title: "Loop", data: { action: 'player#toggleLoop', player: { target: 'loop' } }}
                %i.fas.fa-retweet
              .btn-group.dropup
                %button.btn.dropdown-toggle{type: 'button', title: "Playlists", aria: { expanded: false, haspopup: true }, data: { bs: { toggle: 'dropdown', 'auto-close': 'outside' } }}
                  %i.fas.fa-folder-plus{playlist_icon_attributes(@song, @playlists)}
                .dropdown-menu.dropdown-menu-end.p-2{style: 'min-width: 220px'}
                  = render 'songs/playlist_menu', song: @song, playlists: @playlists
              .btn-group.dropup
                %button.btn.dropdown-toggle.at-layout-button{type: 'button', title: "Layout", aria: { expanded: false, haspopup: true }, data: { bs: { toggle: 'dropdown', 'auto-close': 'outside' } }}
                  %i.fas.fa-table-columns
                .dropdown-menu.dropdown-menu-right.at-layout-options
                  .at-slider-container
                    %span.at-slider-label Scale
                    %input{type: 'range', min: 25, max: 200, value: 100, step: 5, data: { action: 'input->player#changeZoom', player: { target: 'zoomSlider' } }}/
                    %span.at-slider-value{data: { player: { target: 'zoomLabel' } }} 100%
                  .dropdown-divider
                  %a.dropdown-item{href: '#', data: { layout: 'horizontal-screen', action: 'player#changeLayout' }}
                    %i.far.fa-caret-square-right
                    Horizontal Layout (Off-Screen)
                  %a.dropdown-item{href: '#', data: { layout: 'horizontal-bar', action: 'player#changeLayout' }}
                    %i.fas.fa-caret-square-right
                    Horizontal Layout (Bar Wise)
                  %a.dropdown-item{href: '#', data: { layout: 'page', action: 'player#changeLayout' }}
                    %i.fas.fa-caret-square-down
                    Vertical Layout
              %a.at-tab-edit{href: '#', title: "Edit Tab",
                             data: { action: 'player#toggleTabEditing', player: { target: 'tabEdit' } }}
                %i.fas.fa-guitar
              - if @song.audio.present?
                %a.at-sync{href: '#', title: "Sync Editor", data: { action: 'player#toggleSyncEditor' }}
                  %i.fas.fa-wave-square
              = link_to edit_song_path(@song), title: "Edit Song" do
                %i.fas.fa-edit
              = link_to songs_path, title: "Songs" do
                %i.fas.fa-indent
      %template#at-track-template{data: { player: { target: 'trackTemplate' } }}
        .at-track
          .at-track-info
            %input.at-track-check{type: 'checkbox', title: "Show in Score", checked: true}/
            %label.at-track-name
            %span.at-track-type.badge.text-bg-secondary
            .at-track-buttons
              %button.btn.btn-sm.at-track-solo{type: 'button', title: "Solo"} S
              %button.btn.btn-sm.at-track-mute{type: 'button', title: "Mute"} M
          .at-track-volume-row
            %span.at-track-volume-label Volume
            %input.at-track-volume{type: 'range', title: "Track Volume", min: 0, max: 16, value: 8}/
          .at-track-tuning-row
            %span.at-track-tuning-label Tuning
            %select.form-select.form-select-sm.at-track-tuning{title: "Tuning"}
            .spinner-border.spinner-border-sm.at-track-tuning-spinner{role: 'status'}
            %button.btn.btn-sm.btn-outline-secondary.at-track-tuning-reset{type: 'button', title: "Reset this tuning's tab"}
              %i.fas.fa-rotate-left
          .at-track-tuning-message.text-danger.small.d-none
