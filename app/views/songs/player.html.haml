!!!
%html{ xmlns: 'http://www.w3.org/1999/xhtml', 'xml:lang': 'en', lang: 'en', data: { _theme: 'dark', bs: { theme: 'auto' } } }
  %head
    %title= "#{@song.title} (#{@song.artist})"

    %meta{'http-equiv': 'Content-Type', content: 'text/html; charset=UTF-8'}/
    %meta{name: 'viewport', content: 'width=device-width,initial-scale=1'}/
    %meta{name: 'apple-mobile-web-app-capable', content: 'yes'}/
    %meta{name: 'application-name', content: 'Tabby'}/
    %meta{name: 'mobile-web-app-capable', content: 'yes'}/

    %link{href: 'https://fonts.googleapis.com/css?family=Roboto:300,400,400i,500,700&display=swap', rel: 'stylesheet'}/

    = stylesheet_link_tag 'player', integrity: true, data: { 'turbo-track': 'reload' }
    %link{href: 'https://cdn.jsdelivr.net/npm/@fortawesome/fontawesome-free@6.7.2/css/all.min.css', rel: 'stylesheet'}/

    = stylesheet_link_tag 'application', 'data-turbo-track': 'reload'
    = javascript_importmap_tags

  %body
    .at-wrap.loading{data: { controller: 'player', player: { 'song-id-value': @song.to_param, 'sync-points-value': (@song.sync_points || []).to_json } }}
      .at-overlay
        .at-overlay-content
          .spinner-border{role: 'status', style: 'width: 3rem; height: 3rem;'}
      .at-content
        .at-sidebar
          .at-sidebar-content
            .at-track-list{data: { player: { target: 'trackList' } }}
        .at-viewport{data: { player: { target: 'viewport' } }}
          #alphaTab.at-canvas{data: { player: { target: 'canvas' } }}
      .at-footer
        .at-time-slider
          .at-time-slider-value{data: { player: { target: 'timeSliderValue' } }}
        .at-player
          .at-player-left
            %a.at-stop.disabled{href: '#', title: 'Stop', data: { action: 'player#stopPlayback', player: { target: 'stop' } }}
              %i.fas.fa-stop
            %a.at-play-pause.disabled{href: '#', title: 'Play/Pause', data: { action: 'player#playPause', player: { target: 'playPause' } }}
              %i.fas.fa-play
            .btn-group.dropup
              %button.btn.dropdown-toggle{aria: { expanded: false, haspopup: true }, data: { bs: { toggle: 'dropdown' } }, type: 'button'}
                %i.fas.fa-gauge
                %span.at-speed-label{data: { player: { target: 'speedLabel' } }} 1x
              .dropdown-menu.dropdown-menu.at-speed-options
                %a.dropdown-item{href: '#', data: { action: 'player#changeSpeed' }} 0.25x
                %a.dropdown-item{href: '#', data: { action: 'player#changeSpeed' }} 0.5x
                %a.dropdown-item{href: '#', data: { action: 'player#changeSpeed' }} 0.75x
                %a.dropdown-item{href: '#', data: { action: 'player#changeSpeed' }} 0.9x
                %a.dropdown-item{href: '#', data: { action: 'player#changeSpeed' }} 1x
                %a.dropdown-item{href: '#', data: { action: 'player#changeSpeed' }} 1.1x
                %a.dropdown-item{href: '#', data: { action: 'player#changeSpeed' }} 1.25x
                %a.dropdown-item{href: '#', data: { action: 'player#changeSpeed' }} 1.50x
                %a.dropdown-item{href: '#', data: { action: 'player#changeSpeed' }} 2x
            .at-player-loading.progress{data: { player: { target: 'playerLoading' } }}
              %span.progress-left
                %span.progress-bar
              %span.progress-right
                %span.progress-bar
              .progress-value.w-100.h-100.rounded-circle.d-flex.align-items-center.justify-content-center.font-weight-bold
                %span.progress-value-number 0
                %sup.small %
            .at-song-details
              %span.at-song-title{data: { player: { target: 'songTitle' } }}
              \-
              %span.at-song-artist{data: { player: { target: 'songArtist' } }}
            .at-time-position{title: 'Time Position', data: { player: { target: 'timePosition' } }}
          .at-player-right
            %a.at-count-in.disabled{href: '#', title: 'Count-In', data: { action: 'player#toggleCountIn', player: { target: 'countIn' } }}
              %i.fas.fa-hourglass-half
            %a.at-metronome.disabled{href: '#', title: 'Metronome', data: { action: 'player#toggleMetronome', player: { target: 'metronome' } }}
              %i.fas.fa-edit
            %a.at-loop.disabled{href: '#', title: 'Loop', data: { action: 'player#toggleLoop', player: { target: 'loop' } }}
              %i.fas.fa-retweet
            %a.at-print{href: '#', title: 'Print', data: { action: 'player#printScore' }}
              %i.fas.fa-print
            %a.at-download{href: '#', title: 'Download', data: { action: 'player#downloadScore' }}
              %i.fas.fa-download
            .btn-group.dropup
              %button.btn.dropdown-toggle{aria: { expanded: false, haspopup: true }, data: { bs: { toggle: 'dropdown' } }, type: 'button'}
                %i.fas.fa-search
                %span.at-zoom-label{data: { player: { target: 'zoomLabel' } }} 100%
              .dropdown-menu.dropdown-menu-right.at-zoom-options
                %a.dropdown-item{href: '#', data: { action: 'player#changeZoom' }} 25%
                %a.dropdown-item{href: '#', data: { action: 'player#changeZoom' }} 50%
                %a.dropdown-item{href: '#', data: { action: 'player#changeZoom' }} 75%
                %a.dropdown-item{href: '#', data: { action: 'player#changeZoom' }} 90%
                %a.dropdown-item{href: '#', data: { action: 'player#changeZoom' }} 100%
                %a.dropdown-item{href: '#', data: { action: 'player#changeZoom' }} 110%
                %a.dropdown-item{href: '#', data: { action: 'player#changeZoom' }} 125%
                %a.dropdown-item{href: '#', data: { action: 'player#changeZoom' }} 150%
                %a.dropdown-item{href: '#', data: { action: 'player#changeZoom' }} 200%
            .btn-group.dropup
              %button.btn.dropdown-toggle.at-layout-button{aria: { expanded: false, haspopup: true }, data: { bs: { toggle: 'dropdown' } }, type: 'button'}
                Layout
              .dropdown-menu.dropdown-menu-right.at-layout-options
                %a.dropdown-item{href: '#', data: { layout: 'horizontal-screen', action: 'player#changeLayout' }}
                  %i.far.fa-caret-square-right
                  Horizontal Layout (Off-Screen)
                %a.dropdown-item{href: '#', data: { layout: 'horizontal-bar', action: 'player#changeLayout' }}
                  %i.fas.fa-caret-square-right
                  Horizontal Layout (Bar Wise)
                %a.dropdown-item{href: '#', data: { layout: 'page', action: 'player#changeLayout' }}
                  %i.fas.fa-caret-square-down
                  Vertical Layout
      %template#at-track-template{data: { player: { target: 'trackTemplate' } }}
        .at-track
          .at-track-icon
            %i.fas.fa-guitar
          %span.at-track-name
          .at-track-controls
            %button.btn.btn-sm.btn-outline-danger.at-track-mute{type: 'button'} Mute
            %button.btn.btn-sm.btn-outline-success.at-track-solo{type: 'button'} Solo
            %i.fas.fa-volume-up
            %input.at-track-volume{max: '16', min: '0', type: 'range', value: '8'}/
