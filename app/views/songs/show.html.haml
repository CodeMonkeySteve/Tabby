- content_for :title, "#{@song.title} (#{@song.artist})"

%div{id: dom_id(@song)}
  %h1= @song.title
  %h3= @song.artist

  = link_to player_path(@song), class: 'btn btn-success px-5' do
    %i.bi.bi-play-circle
    Play
  = link_to edit_song_path(@song), class: 'btn btn-secondary mx-1' do
    %i.bi.bi-pencil-square
    Edit
