-# the session's CSRF token, not one for just this form's action, since the cover buttons submit it to other actions
= form_with(model: @song, authenticity_token: form_authenticity_token) do |f|
  -# return to the page that linked to the edit page after saving, even after redisplaying the form with errors
  - if @song.persisted?
    = hidden_field_tag :return_to, params[:return_to] || request.referer
  - if @song.errors.any?
    .alert.alert-danger
      %h4= "#{pluralize(@song.errors.count, 'error')} prohibited this song from being saved:"
      %ul
        - @song.errors.full_messages.each do |message|
          %li= message

  .form-inputs
    .mb-3
      = f.label :title, class: 'form-label'
      = f.text_field :title, required: true, class: 'form-control'

    .mb-3
      = f.label :artist, class: 'form-label'
      = f.text_field :artist, class: 'form-control'

    .mb-3
      = f.label :cover, class: 'form-label'
      = f.hidden_field :remove_cover
      = f.hidden_field :cover, value: @song.cached_cover_data
      - if @song.cover
        = image_tag @song.cover.url, alt: "Cover", class: 'img-thumbnail d-block mb-2', style: 'max-width: 160px'
      .input-group
        = f.file_field :cover, class: 'form-control'
        -# these redisplay the form (with its changes) without saving it, and without Turbo since the response isn't a redirect
        - if @song.persisted?
          = button_tag type: 'submit', formaction: find_cover_song_path(@song), class: 'btn btn-outline-secondary',
            title: "Search online catalogs for the cover of this title and artist", data: { turbo: false } do
            %i.bi.bi-search
            Find Cover
          - if @song.cover
            = button_tag type: 'submit', formaction: remove_cover_song_path(@song), formnovalidate: true,
              class: 'btn btn-outline-danger', data: { turbo: false } do
              %i.bi.bi-trash
              Delete Cover

    .mb-3
      = f.label :score, class: 'form-label'
      = f.hidden_field :score, value: @song.cached_score_data
      = f.file_field :score, class: 'form-control'

    - tracks = @song.persisted? ? (@song.score_tracks rescue []) : []
    - if tracks.any?
      .mb-3
        #tracks-label.form-label Tracks
        %table.table.table-sm.align-middle{aria: { labelledby: 'tracks-label' }}
          %tbody
            - tracks.each_with_index do |track, index|
              - detected = track.instrument_type.to_s
              - type = @song.track_types[index] || detected
              %tr
                %td= track.name.presence || "Track #{index + 1}"
                %td
                  = select_tag 'song[track_types][]', options_for_select(Song::INSTRUMENT_TYPES.map { [it.to_s.humanize, it] }, type),
                    id: "song_track_types_#{index}", class: 'form-select form-select-sm', aria: { label: "Track #{index + 1} instrument" }
                %td.text-body-secondary.small
                  - if type != detected
                    = "Detected as #{detected.humanize}"
        .form-text
          The player shows the tracks of your instruments by default.  Uploading a new score detects its tracks' instruments again.

    .mb-3
      = f.label :audio, class: 'form-label'
      = f.hidden_field :audio, value: @song.cached_audio_data
      = f.file_field :audio, class: 'form-control'

    .mb-3
      = f.label :sync_points, class: 'form-label'
      = f.text_area :sync_points, rows: 5, cols: 20, value: (@song.sync_points || []).to_json, class: 'form-control'

  .form-actions
    = button_tag type: 'submit', class: 'btn btn-primary px-5' do
      %i.bi.bi-save
      Save

    = link_to "Cancel", :back, class: 'btn btn-secondary mx-2'
    = content_for :buttons