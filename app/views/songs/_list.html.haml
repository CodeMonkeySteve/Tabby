.songs.container-fluid
  -# loads the songs (rather than counting them with a query), so the cards below reuse them
  - if @songs.length.zero?
    %p.text-body-secondary= params[:q].present? ? "No songs match #{params[:q].inspect}" : "No songs yet"
  - else
    %p.song-count.text-body-secondary= pluralize(@songs.length, "song")
  - if params[:q].present?
    -# stays in the search results frame, which otherwise navigates the whole page
    = link_to songsterr_search_songs_path(q: params[:q]), class: 'songsterr-search btn btn-outline-primary mb-3',
      data: { turbo_frame: 'songs' } do
      %i.bi.bi-globe
      Search Songsterr
  -# one wrapping row, so the gutters between cards are the same at every width, and cards in a row are the same height
  .row.row-cols-1.row-cols-md-3.g-3.mb-3
    - @songs.each do |song|
      .col
        .song.card.h-100
          .card-body
            %span.float-end.d-flex
              %a.btn{href: edit_song_path(song)}
                %i.bi.bi-pencil-square
              .dropdown
                %button.btn{type: 'button', title: "Playlists", aria: { expanded: false, haspopup: true },
                            data: { bs: { toggle: 'dropdown', 'auto-close': 'outside' } }}
                  %i.bi.bi-folder-plus{playlist_icon_attributes(song, @playlists)}
                .dropdown-menu.dropdown-menu-end.p-2{style: 'min-width: 220px'}
                  = render 'songs/playlist_menu', song:, playlists: @playlists
            %a{href: player_path(song)}
              %img.cover.img-fluid.rounded-start.float-start.me-3{src: song.cover&.url || image_path('cover-default.png')}
            %a{href: player_path(song)}
              %h5.card-title= song.title
            %h6.card-text= song.artist
            - song.instrument_types.each do |type|
              %span.badge.text-bg-secondary= type
