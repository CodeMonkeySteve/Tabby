#!/bin/bash
set -e

SRC_DB='postgres://tabby@whale/tabby'
TGT_HOST=localhost
TGT_USER=postgres
TGT_NAME=tabby_devel

dropdb --host "$TGT_HOST" --username "$TGT_USER" --if-exists --force "$TGT_NAME"
createdb --host "$TGT_HOST" --username "$TGT_USER" "$TGT_NAME"
pg_dump -Fc "$SRC_DB" | pg_restore --no-owner --no-privileges --dbname "postgres://$TGT_USER@$TGT_HOST/$TGT_NAME"
bin/rails db:migrate

rsync -avz whale:/library/Tabby/files/ storage/files/
