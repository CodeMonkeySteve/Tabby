{
  "name": "Tabby",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "esbuild app/javascript/*.js vendor/javascript/*.js --outdir=app/assets/builds --bundle --sourcemap --format=esm",
    "watch": "esbuild app/javascript/*.js vendor/javascript/*.js --outdir=app/assets/builds --bundle --sourcemap --format=esm --watch"
  },
  "dependencies": {
    "@coderline/alphatab": "^1.7.1",
    "esbuild": "^0.27.2",
    "sass": "^1.97.1"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  }
}
