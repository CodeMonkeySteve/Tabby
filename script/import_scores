#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative '../config/environment'
require 'jellyfin'
require 'alpha_tab'

$stdout.sync = true

include ActionView::Helpers::NumberHelper

def import_score!(path)
  if (song = Song.from_score(path))
    song.save!
    puts "✅"
  else
    puts "❌"
  end
end

ARGV.each do |path|
  path = Pathname.new(path)
  if path.directory?
    path.glob('*').each do |path|
      print "#{File.basename(path)} … "
      import_score!(path)
    end
  else
    print "#{File.basename(path)}: … "
    import_score!(path)
  end
end
